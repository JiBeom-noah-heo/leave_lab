---
import Base from '../../layouts/Base.astro';
import registry from '../../../public/tools/_registry.json';
---
<Base title="셀러·육아휴직 계산기" description="위탁판매 가격 판정기, 스마트스토어 순이익·목표 판매가, 손익분기 ROAS, 쇼피 마진, 육아휴직 부업 판정기. 실제 실험에서 쓰던 계산을 옮겼고 기준일과 근거를 함께 표시합니다.">
  <h1>계산기</h1>
  <p class="meta">모든 도구는 기준일과 근거를 하단에 표시합니다.</p>
  <div class="tools">
    {registry.map(t => <a href={`/tools/${t.file}`}>{t.name}<small>{t.summary} · 기준일 {t.asOf}</small></a>)}
  </div>
</Base>
