---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import registry from '../../public/tools/_registry.json';
import { verdictClass, ymd } from '../ui';
const posts = (await getCollection('log', p => p.data.lang === 'ko' && !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const slug = (id: string) => id.replace(/^ko\//, '');
const first = posts[posts.length - 1];
---
<Base title="육아휴직 개발자 수익화 실험" description="육아휴직 1년 동안 Claude Code로 프로젝트를 만들고 실제 수익을 기록합니다. 검증 일지, 주간 실험 로그, 셀러용 계산기.">
  <section class="hero">
    <h1>결과와 판정만 기록합니다</h1>
    <p class="lead">육아휴직 중인 개발자가 위탁판매 자동화 같은 수익화 실험을 직접 해 보고, 무엇을 했고 결과가 어땠고 그래서 어떻게 판단했는지만 남깁니다. 숫자에는 기준일을, 판정에는 출처를 붙입니다.</p>
    <div class="stats">
      <div class="stat"><b>{posts.length}편</b>발행한 기록</div>
      <div class="stat"><b>{registry.length}개</b><a href="/tools/">계산기</a></div>
      {first && <div class="stat"><b>{ymd(first.data.date)}</b>기록 시작</div>}
    </div>
  </section>
  <p class="section-h">최근 기록</p>
  <ul class="list">
    {posts.map(p => (
      <li>
        <div class="top">
          <span>{ymd(p.data.date)}</span>
          <span class="badge">{p.data.series}</span>
          {p.data.verdict && <span class={`verdict ${verdictClass(p.data.verdict)}`}>{p.data.verdict}</span>}
        </div>
        <a class="t" href={`/log/${slug(p.id)}/`}>{p.data.title}</a>
        <p>{p.data.description}</p>
      </li>
    ))}
  </ul>
</Base>
