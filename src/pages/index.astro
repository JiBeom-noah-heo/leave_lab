---
import Base from '../layouts/Base.astro';
import LogList from '../components/LogList.astro';
import CategoryTabs from '../components/CategoryTabs.astro';
import Subscribe from '../components/Subscribe.astro';
import { getCollection } from 'astro:content';
import registry from '../../public/tools/_registry.json';
import { SITE } from '../site';

const posts = (await getCollection('log', p => p.data.lang === 'ko' && !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latest = posts.slice(0, 5);
const active = posts.filter(p => p.data.status && p.data.status !== '완료').length;
const dPlus = SITE.leaveStart ? Math.floor((Date.now() - new Date(SITE.leaveStart).getTime()) / 86_400_000) : null;
const featured = registry.find(t => 'featured' in t && t.featured) ?? registry[0];
const others = registry.filter(t => t !== featured);
---
<Base title="육아휴직 개발자의 수익화 실험실 — leave-lab" description="육아휴직 1년 동안 시도하는 작은 수익화 실험들. 가설, 과정, 숫자, 실패까지 그대로 기록합니다. 실험 로그와 직접 만든 계산기.">
  <section class="container hero">
    <div class="hero-text">
      <span class="eyebrow">EXPERIMENT LOG · 2026–</span>
      <h1>육아휴직 개발자의<br>수익화 실험실</h1>
      <p class="lead">두 아이를 키우며 1년 동안 시도하는 작은 실험들. 가설, 과정, 숫자, 실패까지 그대로 기록합니다.</p>
      <div class="actions">
        <a class="btn" href="#logs">최신 실험 보기</a>
        <a class="btn ghost" href={`/tools/${featured.file}`}>육아휴직 급여 계산하기</a>
      </div>
    </div>
    <aside class="card lift lab-status" aria-label="실험 현황">
      <div class="card-head"><span>LAB STATUS</span><span style="color:var(--accent)">● 진행 중</span></div>
      <div class="grid">
        <div class="stat"><small>휴직</small><b class={dPlus === null ? 'todo' : ''} data-dplus={SITE.leaveStart || undefined}>D+{dPlus ?? '[N]'}</b></div>
        <div class="stat"><small>진행 중 실험</small><b>{active}개</b></div>
        <div class="stat"><small>이번 달 수익</small><b class={SITE.monthlyRevenue === null ? 'todo' : ''}>₩{SITE.monthlyRevenue === null ? '[금액]' : SITE.monthlyRevenue.toLocaleString('ko-KR')}</b></div>
        <div class="stat"><small>발행 글</small><b>{posts.length}편</b></div>
      </div>
      <div class="card-foot">{SITE.statusFootnote}</div>
    </aside>
  </section>

  <section id="tools" class="band">
    <div class="container">
      <div class="section-head">
        <div class="titles"><span class="eyebrow light">TOOLS</span><h2>직접 만든 계산기</h2></div>
        <a class="more" href="/tools/">전체 보기 →</a>
      </div>
      <div class="tool-grid">
        <a class="tool-feature" href={`/tools/${featured.file}`}>
          <span class="tag-accent">대표 도구</span>
          <span class="name">{featured.name}</span>
          <span class="desc">{featured.summary}</span>
          <span class="go">계산하러 가기 →</span>
        </a>
        {others.map(t => (
          <a class="tool-mini" href={`/tools/${t.file}`}>
            <span class="k">기준일 {t.asOf}</span>
            <span class="name">{t.name}</span>
            <span class="desc">{t.summary}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="logs" class="container logs">
    <div class="section-head">
      <div class="titles"><span class="eyebrow">LATEST LOGS</span><h2>최근 실험 로그</h2></div>
      <CategoryTabs target="latest-logs" />
    </div>
    <LogList posts={latest} id="latest-logs" />
    <a class="more" href="/log/" style="align-self:flex-end;padding:4px 0">실험 로그 전체 보기 →</a>
  </section>

  <section id="about" class="container about">
    <div class="card">
      <div class="who">
        <span class="eyebrow">RESEARCHER</span>
        <h2>{SITE.authorTitle}</h2>
        <p>{SITE.authorBio}</p>
      </div>
      <Subscribe variant="card" id="subscribe-home" />
    </div>
  </section>
</Base>
<script>
  // 휴직 D+N은 빌드 시점이 아니라 보는 시점 기준으로 센다. 글이 없어 재배포가 없는 날에도 맞는 숫자가 보인다.
  const el = document.querySelector<HTMLElement>('[data-dplus]');
  const start = el?.dataset.dplus ? Date.parse(el.dataset.dplus) : NaN;
  if (el && !Number.isNaN(start)) el.textContent = `D+${Math.floor((Date.now() - start) / 86_400_000)}`;
</script>
