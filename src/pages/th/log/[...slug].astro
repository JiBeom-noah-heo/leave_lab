---
import Base from '../../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const posts = await getCollection('log', p => p.data.lang === 'th' && !p.data.draft);
  return posts.map(p => ({ params: { slug: p.id.replace(/^th\//, '') }, props: { p } }));
}
const { p } = Astro.props;
const { Content } = await render(p);
---
<Base lang="th" title={p.data.title} description={p.data.description}>
  <article class="post">
    <h1>{p.data.title}</h1>
    <p class="meta"><span>{p.data.date.toISOString().slice(0, 10)}</span></p>
    <Content />
    {p.data.sources.length > 0 && (
      <div class="sources"><strong>แหล่งอ้างอิง</strong><ul>{p.data.sources.map(s => <li><a href={s.url} rel="nofollow noopener" target="_blank">{s.title}</a></li>)}</ul></div>
    )}
  </article>
</Base>
