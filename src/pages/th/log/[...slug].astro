---
import PostLayout from '../../../layouts/PostLayout.astro';
import { getCollection } from 'astro:content';
import { ymd } from '../../../ui';
export async function getStaticPaths() {
  const posts = (await getCollection('log', p => p.data.lang === 'th' && !p.data.draft))
    .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
  const slug = (id: string) => id.replace(/^th\//, '');
  const brief = (q: typeof posts[number]) => ({ slug: slug(q.id), title: q.data.title, label: q.data.expId ?? ymd(q.data.date) });
  return posts.map((p, i) => ({
    params: { slug: slug(p.id) },
    props: { p, prev: i > 0 ? brief(posts[i - 1]) : null, next: i < posts.length - 1 ? brief(posts[i + 1]) : null },
  }));
}
const { p, prev, next } = Astro.props;
---
<PostLayout p={p} prev={prev} next={next} lang="th" />
