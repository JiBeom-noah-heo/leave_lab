---
// 구독 폼. 지금은 UI만 있다. 제출하면 안내 문구만 보여 주고 아무 데도 보내지 않는다.
interface Props { variant?: 'card' | 'band'; id?: string }
const { variant = 'card', id = 'subscribe-email' } = Astro.props;
---
{variant === 'band' ? (
  <form class="subscribe-band" data-subscribe novalidate>
    <div class="text">
      <label for={id}>다음 실험 결과를 메일로 받기</label>
      <span class="sub">한 달에 한 번, 숫자와 실패담만 보냅니다</span>
    </div>
    <input id={id} type="email" placeholder="이메일 주소" autocomplete="email" />
    <button class="btn mint" type="submit">구독하기</button>
    <p class="note" aria-live="polite"></p>
  </form>
) : (
  <form class="subscribe" data-subscribe novalidate>
    <label for={id}>월간 실험 리포트 받기</label>
    <input id={id} type="email" placeholder="이메일 주소" autocomplete="email" />
    <button class="btn dark" type="submit">구독하기</button>
    <p class="note" aria-live="polite"></p>
  </form>
)}
<script>
  document.querySelectorAll<HTMLFormElement>('form[data-subscribe]').forEach(f => {
    f.addEventListener('submit', e => {
      e.preventDefault();
      const note = f.querySelector<HTMLElement>('.note');
      if (note) note.textContent = '구독 기능은 준비 중입니다. 지금은 RSS(/rss.xml)로 새 글을 받아 보실 수 있습니다.';
    });
  });
</script>
