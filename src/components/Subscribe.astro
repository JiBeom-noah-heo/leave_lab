---
// 새 글 받아 보기. 메일 구독은 보내 줄 서비스가 정해질 때까지 숨겨 두고, RSS 링크만 보여 준다.
// 메일 구독을 다시 켤 때: 이 컴포넌트에 폼을 넣고 action을 서비스 주소로 두면 된다(개인정보처리방침도 함께 고칠 것).
interface Props { variant?: 'card' | 'band'; lang?: 'ko' | 'th' }
const { variant = 'card', lang = 'ko' } = Astro.props;
const t = lang === 'th'
  ? { title: 'รับบันทึกใหม่', sub: 'เพิ่มฟีดนี้ในแอป RSS แล้วจะได้รับทันทีที่มีบันทึกใหม่', btn: 'ติดตามทาง RSS →' }
  : { title: '다음 실험 결과 받아 보기', sub: 'RSS 리더에 넣어 두면 새 글이 올라올 때 바로 받습니다', btn: 'RSS로 구독하기 →' };
---
{variant === 'band' ? (
  <aside class="subscribe-band" aria-label={t.title}>
    <div class="text">
      <strong>{t.title}</strong>
      <span class="sub">{t.sub}</span>
    </div>
    <a class="btn mint" href="/rss.xml">{t.btn}</a>
  </aside>
) : (
  <aside class="subscribe" aria-label={t.title}>
    <strong>{t.title}</strong>
    <span class="sub">{t.sub}</span>
    <a class="btn dark" href="/rss.xml">{t.btn}</a>
  </aside>
)}
