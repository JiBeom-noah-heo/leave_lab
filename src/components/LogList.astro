---
// 글 목록 한 줄 = 번호(expId 또는 날짜) · 제목 · 분류 · 상태. CategoryTabs가 data-cat으로 거른다.
import type { CollectionEntry } from 'astro:content';
import { ymd, statusOf, categoryOf } from '../ui';
interface Props { posts: CollectionEntry<'log'>[]; lang?: 'ko' | 'th'; id?: string }
const { posts, lang = 'ko', id } = Astro.props;
const base = lang === 'th' ? '/th/log/' : '/log/';
const slug = (s: string) => s.replace(/^(ko|th)\//, '');
---
<div class="log-list" id={id}>
  {posts.map(p => { const s = statusOf(p.data); const cat = categoryOf(p.data); return (
    <a class="log-row" href={`${base}${slug(p.id)}/`} data-cat={cat ?? ''}>
      <span class="no">{p.data.expId ?? ymd(p.data.date)}</span>
      <span class="title">{p.data.title}</span>
      <span class="pill">{cat ?? p.data.series}</span>
      {s.label && <span class={`status ${s.cls}`}>{s.label}</span>}
    </a>
  ); })}
  <p class="log-empty" hidden>{lang === 'th' ? 'ยังไม่มีบันทึกในหมวดนี้' : '이 분류의 글이 아직 없습니다.'}</p>
</div>
