---
import '../styles/global.css';
import { SITE } from '../site';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
interface Props { title: string; description: string; lang?: 'ko' | 'th'; }
const { title, description, lang = 'ko' } = Astro.props;
const ads = import.meta.env.PUBLIC_ADSENSE_CLIENT;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#F3F5F0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {SITE.naverVerification && <meta name="naver-site-verification" content={SITE.naverVerification} />}
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <link rel="alternate" type="application/rss+xml" href="/rss.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+KR:wght@400;500;700&family=IBM+Plex+Mono:wght@400;500;600&family=Noto+Sans+Thai:wght@400;500;700&display=swap" />
  {ads && <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ads}`} crossorigin="anonymous"></script>}
</head>
<body>
  <SiteHeader lang={lang} />
  <slot />
  <SiteFooter lang={lang} />
</body>
</html>
