---
import '../styles/global.css';
import { SITE } from '../site';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
interface Props {
  title: string;
  description: string;
  lang?: 'ko' | 'th';
  image?: string;               // 링크 공유 미리보기 그림. 없으면 사이트 대표 이미지
  type?: 'website' | 'article'; // 글 상세는 article
  published?: Date;             // article일 때 발행일
  modified?: Date;              // article일 때 수정일
  schema?: object | object[];   // JSON-LD 구조화 데이터. 검색엔진이 글·도구·현재 위치를 읽는 데 쓴다
  noindex?: boolean;            // 아직 내용이 없는 페이지(글 0편인 태국어 홈 등)는 색인에서 뺀다
}
const {
  title, description, lang = 'ko', image = '/img/2026/og-default.png',
  type = 'website', published, modified, schema, noindex = false,
} = Astro.props;
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
const ads = import.meta.env.PUBLIC_ADSENSE_CLIENT;
const schemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
// JSON 안의 '<'는 스크립트 닫힘으로 읽히지 않게 이스케이프한다
const ld = (s: object) => JSON.stringify(s).replace(/</g, '\\u003c');
const modifiedAt = modified ?? published;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#F3F5F0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex,follow" />}
  {SITE.naverVerification && <meta name="naver-site-verification" content={SITE.naverVerification} />}
  <link rel="canonical" href={pageUrl} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta property="og:type" content={type} />
  <meta property="og:site_name" content="leave-lab" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={pageUrl} />
  <meta property="og:image" content={imageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content={lang === 'th' ? 'th_TH' : 'ko_KR'} />
  {type === 'article' && published && <meta property="article:published_time" content={published.toISOString()} />}
  {type === 'article' && modifiedAt && <meta property="article:modified_time" content={modifiedAt.toISOString()} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imageUrl} />
  <link rel="alternate" type="application/rss+xml" href="/rss.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+KR:wght@400;500;700&family=IBM+Plex+Mono:wght@400;500;600&family=Noto+Sans+Thai:wght@400;500;700&display=swap" />
  {schemas.map(s => <script type="application/ld+json" is:inline set:html={ld(s)} />)}
  {ads && <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ads}`} crossorigin="anonymous"></script>}
</head>
<body>
  <SiteHeader lang={lang} />
  <slot />
  <SiteFooter lang={lang} />
</body>
</html>
