---
// 글 상세 공통 레이아웃 (design/Post.dc.html). ko/th 글 페이지가 함께 쓴다.
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import Base from './Base.astro';
import Subscribe from '../components/Subscribe.astro';
import { SITE } from '../site';
import { ymd, readingMinutes, statusOf, categoryOf, relatedTools } from '../ui';
import { seriesOf, episodesOf } from '../series';
import { postFlags, AFFILIATE_NOTICE } from '../postRules';

export interface Brief { slug: string; title: string; label: string }
interface Props { p: CollectionEntry<'log'>; prev: Brief | null; next: Brief | null; lang?: 'ko' | 'th' }
const { p, prev, next, lang = 'ko' } = Astro.props;
const { Content, headings } = await render(p);
const d = p.data;
const th = lang === 'th';
const base = th ? '/th/log/' : '/log/';
const slugOf = (id: string) => id.replace(/^(ko|th)\//, '');
const toc = headings.filter(h => h.depth === 2);
const label = d.expId ?? d.series;
const s = statusOf(d);
const cat = categoryOf(d);
const hasCard = Boolean(d.hypothesis || d.method || d.result);
const ads = import.meta.env.PUBLIC_ADSENSE_CLIENT;
const siteUrl = Astro.site?.href ?? 'https://leave-lab.com/';
const pageUrl = new URL(Astro.url.pathname, siteUrl).href;

// 관련 글: 태그가 겹치는 같은 언어의 글. 겹친 태그 수로 고르고, 분류가 같으면 조금 더 앞에 둔다.
const myTags = new Set(d.tags.map(t => t.toLowerCase()));
const related = (await getCollection('log', q => q.data.lang === lang && !q.data.draft && q.id !== p.id))
  .map(q => ({ q, score: q.data.tags.filter(t => myTags.has(t.toLowerCase())).length + (cat && categoryOf(q.data) === cat ? 0.5 : 0) }))
  .filter(x => x.score >= 1)
  .sort((a, b) => b.score - a.score || b.q.data.date.valueOf() - a.q.data.date.valueOf())
  .slice(0, 3);
const tools = relatedTools(d);
const flags = postFlags(d, p.body ?? '');

// 연재: 같은 project의 글을 1편부터 순서대로. 연재 안에서는 이전·다음 글도 연재 순서를 따른다.
const ser = seriesOf(d);
const episodes = ser ? episodesOf(ser, await getCollection('log', q => q.data.lang === lang && !q.data.draft)) : [];
const epIdx = episodes.findIndex(q => q.id === p.id);
const inSeries = Boolean(ser) && epIdx >= 0;
const epBrief = (i: number): Brief => ({ slug: slugOf(episodes[i].id), title: episodes[i].data.title, label: `${ser!.name} ${i + 1}편` });
const nav = inSeries
  ? { prev: epIdx > 0 ? epBrief(epIdx - 1) : null, next: epIdx < episodes.length - 1 ? epBrief(epIdx + 1) : null }
  : { prev, next };
const seriesUrl = ser ? new URL(`/series/${ser.id}/`, siteUrl).href : null;

const t = th
  ? { home: 'หน้าแรก', logs: 'บันทึก', read: (m: number) => `อ่าน ${m} นาที`, started: 'เริ่ม', published: 'เผยแพร่', contents: 'CONTENTS', sources: 'SOURCES', related: 'RELATED', tool: 'เครื่องมือ', asOf: 'ข้อมูล ณ', prev: '←', next: '→' }
  : { home: '홈', logs: '실험 로그', read: (m: number) => `읽는 데 ${m}분`, started: '시작', published: '발행', contents: 'CONTENTS', sources: 'SOURCES', related: 'RELATED', tool: '계산기', asOf: '기준일', prev: '←', next: '→' };

// 구조화 데이터: 글(BlogPosting)과 현재 위치(BreadcrumbList)
const org = { '@type': 'Organization', name: 'leave-lab', url: siteUrl };
const schema = [
  {
    '@context': 'https://schema.org', '@type': 'BlogPosting',
    headline: d.title, description: d.description, url: pageUrl, mainEntityOfPage: pageUrl,
    datePublished: ymd(d.date), dateModified: ymd(d.date), inLanguage: lang,
    keywords: d.tags.join(', '), articleSection: cat ?? d.series,
    image: new URL('/img/2026/og-default.png', siteUrl).href,
    author: org,
    publisher: { ...org, logo: { '@type': 'ImageObject', url: new URL('/icon-512.png', siteUrl).href } },
    ...(inSeries ? { isPartOf: { '@type': 'CreativeWorkSeries', name: ser!.name, url: seriesUrl }, position: epIdx + 1 } : {}),
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.home, item: new URL(th ? '/th/' : '/', siteUrl).href },
      { '@type': 'ListItem', position: 2, name: t.logs, item: new URL(th ? '/th/' : '/log/', siteUrl).href },
      { '@type': 'ListItem', position: 3, name: d.title, item: pageUrl },
    ],
  },
];
---
<Base title={d.title} description={d.description} lang={lang} type="article" published={d.date} schema={schema} noindex={flags.noindex}>
  <main class="container post-main">
    <nav class="crumbs" aria-label="현재 위치">
      <a href={th ? '/th/' : '/'}>{t.home}</a><span>/</span><a href={th ? '/th/' : '/log/'}>{t.logs}</a><span>/</span><span>{label}</span>
    </nav>

    <div class="post-head">
      <div class="labels">
        {d.expId && <span class="id">{d.expId}</span>}
        <span class="pill">{cat ?? d.series}</span>
        {s.label && <span class={`status ${s.cls}`}>● {s.label}</span>}
      </div>
      <h1>{d.title}</h1>
      <div class="byline">
        {SITE.author && <span>{SITE.author}</span>}<span>{ymd(d.date)}</span><span>{t.read(readingMinutes(p.body ?? ''))}</span>
      </div>
    </div>

    {flags.affiliate && <p class="affiliate-notice" role="note">{AFFILIATE_NOTICE[lang]}</p>}

    {inSeries && !th && (
      <nav class="series-bar" aria-label="연재">
        <a href={`/series/${ser!.id}/`}><span class="k">SERIES</span><span class="t">{ser!.name}</span></a>
        <span class="pos">{epIdx + 1} / {episodes.length}편</span>
      </nav>
    )}

    {hasCard && (
      <section class="card lift exp-card" aria-label="실험 요약">
        <div class="card-head"><span>EXPERIMENT CARD</span><span>{d.startedOn ? `${t.started} ${ymd(d.startedOn)}` : `${t.published} ${ymd(d.date)}`}</span></div>
        <div class="grid">
          {d.hypothesis && <div class="cell"><span class="k">HYPOTHESIS</span><span class="v">{d.hypothesis}</span></div>}
          {d.method && <div class="cell"><span class="k">METHOD</span><span class="v">{d.method}</span></div>}
          {d.result && <div class="cell"><span class="k">RESULT</span><span class="v">{d.result}</span></div>}
        </div>
      </section>
    )}

    <div class="post-cols">
      <article class="prose log"><Content /></article>
      {toc.length > 0 && (
        <details class="card toc" aria-label="목차" open>
          <summary class="k"><span>{t.contents}</span><span class="chev" aria-hidden="true">▾</span></summary>
          {toc.map(h => <a href={`#${h.slug}`}>{h.text}</a>)}
        </details>
      )}
    </div>

    {d.tags.length > 0 && <div class="tags">{d.tags.map(tag => <span>#{tag}</span>)}</div>}
    {ads && <div class="ad"><ins class="adsbygoogle" style="display:block" data-ad-client={ads} data-ad-format="auto" data-full-width-responsive="true"></ins><script is:inline>(adsbygoogle=window.adsbygoogle||[]).push({});</script></div>}

    {d.sources.length > 0 && (
      <section class="card sources" aria-label="출처">
        <div class="card-head"><span>{t.sources}</span><span>{d.sources.length}</span></div>
        <ul>{d.sources.map(src => <li><a href={src.url} rel="nofollow noopener" target="_blank">{src.title}</a></li>)}</ul>
      </section>
    )}

    {(related.length > 0 || tools.length > 0) && (
      <section class="related-wrap" aria-label="관련 글과 계산기">
        <span class="eyebrow">{t.related}</span>
        <div class="related-grid">
          {related.map(({ q }) => (
            <a class="card rel" href={`${base}${slugOf(q.id)}/`}>
              <span class="k">{ymd(q.data.date)} · {categoryOf(q.data) ?? q.data.series}</span>
              <span class="t">{q.data.title}</span>
            </a>
          ))}
          {tools.map(tool => (
            <a class="card rel tool" href={`/tools/${tool.file}`}>
              <span class="k">{t.tool} · {t.asOf} {tool.asOf}</span>
              <span class="t">{tool.name}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    {(nav.prev || nav.next) && (
      <nav class="pn" aria-label={inSeries ? '연재의 이전·다음 편' : '이전·다음 글'}>
        {nav.prev ? <a class="card" href={`${base}${nav.prev.slug}/`}><span class="k">{t.prev} {nav.prev.label}</span><span class="t">{nav.prev.title}</span></a> : <span />}
        {nav.next && <a class="card next" href={`${base}${nav.next.slug}/`}><span class="k">{nav.next.label} {t.next}</span><span class="t">{nav.next.title}</span></a>}
      </nav>
    )}

    <Subscribe variant="band" lang={lang} />
  </main>
</Base>
<script>
  // 좁은 화면(목차가 본문 위로 올라오는 폭)에서는 목차를 접어 둔다. 데스크톱에서는 펼친 채 옆에 고정.
  const toc = document.querySelector<HTMLDetailsElement>('details.toc');
  if (toc && matchMedia('(max-width: 900px)').matches) toc.open = false;
</script>
